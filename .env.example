# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Read by `pnpm infra:*` (podman compose --env-file .env) and `pnpm db:reset` (infra/local/init-db.sh).
# The admin app has its own file: studio/.env.example.

# --- Local Postgres container (infra/local/docker-compose.yml) ---
# Also passed to the local Flink containers as DB_PASSWORD.
POSTGRES_PASSWORD=

# --- Remote database for `pnpm db:reset` ---
# Leave DB_HOST empty to reset the local postgres-db container instead.
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_NAME=auroracy
DB_PASSWORD=

# --- Flink jobs (event-processor) ---
# Set these in the job environment. Each component contract in docs/internal/architecture/components/ lists the tuning variables.
# DB_HOST=postgres
# DB_READ_HOST=
# DB_PORT=5432
# DB_DATABASE=auroracy
# DB_USER=postgres
# DB_PASSWORD=            # required, no default
# KAFKA_BROKERS=redpanda:29092
# KAFKA_EVENT_TOPIC_PATTERN=snowplow-good
# SNOWPLOW_LEGACY_CONTEXT_SCHEMA_PREFIX=iglu:com.example.snowplow/   # vendor prefix of the tracker's legacy context schemas
# KAFKA_SECURITY_PROTOCOL=         # e.g. SASL_SSL; empty means plaintext
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_JAAS_CONFIG=          # contains the Kafka password
# KAFKA_SSL_TRUSTSTORE_LOCATION=
# KAFKA_SSL_TRUSTSTORE_TYPE=PEM
