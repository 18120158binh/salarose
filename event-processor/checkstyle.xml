<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Apache Flink Standard Checkstyle Configuration
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, xml"/>

    <!-- File Structure Rules -->
    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- TreeWalker Rules for Java Source Code -->
    <module name="TreeWalker">

        <!-- Import Enforcement -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Single-line Inline Guard & Curly Brace Rules -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <!--
          Spotless inlines a braced guard (if without else whose body is one return, throw,
          continue, or break) and then wraps it past 120 columns, leaving it braceless on two lines.
        -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="NeedBraces"/>
            <property name="query" value="//LITERAL_IF[not(LITERAL_ELSE)][LITERAL_RETURN or LITERAL_THROW or LITERAL_CONTINUE or LITERAL_BREAK]"/>
        </module>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Modifier & Type Rules -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Naming Conventions -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
    </module>
</module>
