# Snowplow Stream Collector Configuration (Kafka/Redpanda)

collector {
  interface = "0.0.0.0"
  port = 8080

  p3p {
    policyRef = "/w3c/p3p.xml"
    CP = "NOI DSP COR ADM DEVa TAIo OUR BUS UNI COM NAV INT LOC"
  }

  cookie {
    enabled = true
    expiration = "365 days"
    name = "sp"
    domains = []
  }

  streams {
    good = "snowplow-good"
    bad = "snowplow-bad"

    sink {
      enabled = "kafka"
      brokers = "redpanda:29092"
      
      # Basic configuration properties for Kafka client
      # Must be defined under the producerConf key (or passed directly to Kafka)
      # We keep them simple for dev testing
      retries = 3

      producerConf {
        "enable.idempotence" = "false"
      }
    }

    buffer {
      byteLimit = 3145728
      recordLimit = 1
      timeLimit = 100
    }

  }
}
