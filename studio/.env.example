# Copy to studio/.env.local and fill in. Never commit real values.

# Postgres connection, required. Use the password from the root .env (POSTGRES_PASSWORD).
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/auroracy

# OpenAI-compatible LLM endpoint for AI journey generation (app/api/generate-journey).
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_MODEL=
# Requests per user to the model, counted in each app process. Integers from 1 to 10000.
# AI_GENERATION_LIMIT_PER_MINUTE=10
# AI_GENERATION_LIMIT_PER_DAY=100
# Data ingestion API (POST /v1/business-events). See docs/internal/operations/configuration.md.
# INGESTION_KAFKA_BROKERS=localhost:9092
# KAFKA_BUSINESS_EVENTS_TOPIC=business-events
# INGESTION_RATE_LIMIT_PER_SECOND=100
# Dead-letter reader for studio v2's data health pages. See docs/internal/operations/configuration.md.
# DEAD_LETTER_KAFKA_BROKERS=localhost:9092
# KAFKA_EVENT_DEAD_LETTER_TOPIC=snowplow-parsed-dead-letters

# --- Staff sign-in with OpenID Connect (docs/internal/features/admin-authentication.md) ---
# Issuer URL. The app reads <issuer>/.well-known/openid-configuration.
# Google: https://accounts.google.com
# Microsoft Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
# Keycloak: https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Register this exact URL at the provider.
OIDC_REDIRECT_URL=http://localhost:3001/api/auth/oidc/callback
# Space-separated. Must include openid and email.
OIDC_SCOPES=openid email profile
# The login button reads "Sign in with <name>".
# OIDC_NAME=SSO
# Required. The ID token claim that holds the user's roles or groups at the provider, and a JSON
# object that maps its values to the Studio roles admin and editor. A sign-in whose claim maps to
# no role is refused. The first sign-in creates the staff user, and every sign-in updates the role.
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAP='{"studio-admin":"admin","studio-editor":"editor"}'
# Send the ID token as id_token_hint at sign-out, for a provider that requires it, such as Okta.
# OIDC_LOGOUT_ID_TOKEN_HINT=false
# Several providers: list their ids, leave the unprefixed OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET, and settings above unset, and set OIDC_<ID>_ISSUER, OIDC_<ID>_CLIENT_ID,
# OIDC_<ID>_CLIENT_SECRET, and so on for each id. OIDC_REDIRECT_URL is shared.
# OIDC_PROVIDERS=keycloak,entra
# Signs the session cookie. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Session lifetime in seconds. Default 43200 (12 hours).
# SESSION_MAX_AGE_SECONDS=43200

# The workspace name in the studio v2 top bar. Default "Studio".
# STUDIO_WORKSPACE_NAME=Acme Retail
